# =============================================
# Discord Bot Configuration (required)
# =============================================

# Single bot token for unified mode
UNIFIED_DISCORD_TOKEN=your_discord_bot_token_here

# Application (client) ID from Discord Developer Portal
UNIFIED_CLIENT_ID=your_application_client_id_here

# Developer user ID (optional) - grants /backup permission to this user
UNIFIED_DEVELOPER_ID=

# Guild ID (optional) - register commands to a single guild instead of globally
UNIFIED_GUILD_ID=

# =============================================
# Database Path (optional)
# =============================================

# Path to the SQLite database file (default: data/unified.db)
UNIFIED_DB_PATH=data/unified.db

# =============================================
# Railway / PostgreSQL Persistence (required for Railway deployment)
# =============================================

# PostgreSQL connection URL - set this in Railway using the Postgres plugin
# Railway provides this automatically as DATABASE_URL when you add a Postgres database
DATABASE_URL=

# Enable PostgreSQL sync (default: true when DATABASE_URL is set)
POSTGRES_SYNC_ENABLED=true

# Snapshot identifier (default: main)
POSTGRES_SNAPSHOT_ID=main

# How often to sync SQLite → PostgreSQL in milliseconds (default: 30000 = 30s)
POSTGRES_SYNC_INTERVAL_MS=30000

# Number of historical snapshot rows to keep in PostgreSQL (default: 2)
POSTGRES_HISTORY_KEEP=2
